{
  "compilerOptions": {
    // Required because this is part of a project reference setup
    "composite": true,

    // Node.js module system for config files
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Enables Node globals like process.env
    "types": ["node"]
  },

  // Only include tooling/config files (not your app code)
  "include": [
    "drizzle.config.ts"
    // You can also add: vite.config.ts, eslint.config.ts, etc.
  ]
}
