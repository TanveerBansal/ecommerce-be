{
  "compilerOptions": {
    // Enables project references (required when using "references")
    "composite": true,

    // Modern Node.js JavaScript output
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    // Where compiled JS goes
    "outDir": "./dist",

    // Only compile code inside /src
    // Keeps build clean and separated
    "rootDir": "./src",

    // Strict type-checking (recommended for safety)
    "strict": true,

    // Helps with importing CommonJS modules
    "esModuleInterop": true,

    // Speeds up builds by skipping extra type checks in libraries
    "skipLibCheck": true,

    // Adds Node.js globals like process, Buffer, etc.
    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
