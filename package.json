{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "ecommerce",
  "license": "ISC",
  "author": "tanveer",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "npm run clean && npm run type-check && npm run compile",
    "compile": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "seed": "npx tsx src/db/seeds/index.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts --name",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
